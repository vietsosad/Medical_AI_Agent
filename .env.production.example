# ============================================
# Production env vars — reference for Cloud Run / Fly.io / Render / Neon / Vercel
# ============================================
# Do NOT put real secrets in this file or commit it with values filled in.
# On Cloud Run, everything marked [SECRET] below should be created with
# `gcloud secrets create` and attached via `--set-secrets`, not `--set-env-vars`.
SIMPLE_AGENT_ENABLED=true

# ---- App ----
APP_ENV=production
APP_PORT=8000
APP_HOST=0.0.0.0
# Comma-separated, no trailing slashes. Must match the deployed frontend
# origin exactly (Vercel prod URL and/or your custom domain).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-app.vercel.app,https://app.yourdomain.com

# ---- LLM ---- [SECRET]
MODEL_NAME=gpt-4o-mini
OPENAI_API_KEY=your-openai-api-key

# ---- LLM-as-Judge evaluation (report-only, uses OPENAI_API_KEY above) ----
LLM_JUDGE_PROVIDER=openai
LLM_JUDGE_MODEL=gpt-5-mini
LLM_JUDGE_TEMPERATURE=0
LLM_JUDGE_MAX_RETRIES=2
LLM_JUDGE_MAX_OUTPUT_TOKENS=2000

# ---- Database (Neon) ---- [SECRET]
# Use Neon's DIRECT (non-pooled, no "-pooler" in the host) connection string
# for both — SYNC_DATABASE_URL backs durable DB workflows that need a stable session.
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<neon-host>/<database>?ssl=require
SYNC_DATABASE_URL=postgresql://<user>:<password>@<neon-host>/<database>?sslmode=require

# ---- Vector Store ----
# Must match the revision baked into the Docker image
# (see ARG EMBEDDING_MODEL_REVISION in Dockerfile) or the runtime embedding
# load will miss the pre-baked cache and try to hit the network instead.
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_MODEL_REVISION=5617a9f61b028005a4858fdac845db406aefb181
# Do NOT set HF_HUB_OFFLINE=1 here unless you have verified the baked cache
# resolves — leaving it unset lets the app fall back to a network download
# instead of hard-failing if the baked revision ever drifts from this file.

# ---- Security ---- [SECRET]
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Never reuse the insecure default from src/config.py.
JWT_SECRET_KEY=your-production-jwt-secret

# ---- Frontend ----
# Set this on Vercel (Project Settings > Environment Variables), not here —
# it points the Next.js app at the deployed backend URL.
# NEXT_PUBLIC_API_URL=https://<your-cloud-run-service>.a.run.app

# ---- LLM Configuration (Copied from .env) ----
GOOGLE_API_KEY=your-google-api-key
GROQ_API_KEY=your-groq-api-key

# UNUSED by current src/config.py / src/services/llm_provider.py:
# Provider priority is currently code-defined as OpenAI -> Gemini -> Groq -> Mock.
# GOOGLE_API_KEY and GROQ_API_KEY are still used as fallback credentials, but
# these selector/model variables are ignored because Settings(extra="ignore") drops them.
# DEFAULT_LLM_PROVIDER=gemini
# FALLBACK_LLM_PROVIDER=groq
# GEMINI_MODEL=gemini-1.5-pro
# FAST_REFLEX_MODEL=gemini-1.5-flash

# ---- OAuth 2.0 (Google & GitHub) (Copied from .env) ----
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback/google

GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:3000/auth/callback/github

# ---- Email / SMTP Server Configuration ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-hospital-system-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=noreply-aitriage@hospital.vn
SMTP_FROM_NAME="Hệ thống AI Triage Cấp cứu"
