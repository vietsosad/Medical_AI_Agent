# ============================================================
# Frontend — biến môi trường
# Sao chép file này thành `.env.local` rồi chỉnh nếu cần.
#   cp .env.local.example .env.local
#
# KHÔNG đặt khoá API của nhà cung cấp LLM ở đây. Mọi biến
# NEXT_PUBLIC_* đều bị nhúng thẳng vào bundle và ai mở trình
# duyệt cũng đọc được. Khoá LLM chỉ nằm ở `.env` của backend.
# ============================================================

# Địa chỉ backend FastAPI.
NEXT_PUBLIC_API_URL="http://localhost:8000"

# Tên cookie lưu phiên đăng nhập. Giữ nguyên nếu không có lý do đổi.
NEXT_PUBLIC_ACCESS_TOKEN_KEY="ai20k_access_token"
NEXT_PUBLIC_REFRESH_TOKEN_KEY="ai20k_refresh_token"

# "YES" = các điểm vào chính (navbar, sidebar điều dưỡng, nút khám mới,
# trang sau khi điều dưỡng đăng nhập) trỏ sang luồng Triage Agent
# (/triage-pilot, /clinical/queue-pilot). Đây là luồng đang được phát triển.
# Đặt "NO" để quay về luồng cũ. Xem frontend/src/lib/agent-mode.ts.
NEXT_PUBLIC_TRIAGE_PILOT_ACTIVE="YES"
