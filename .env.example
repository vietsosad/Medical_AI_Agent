# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git!

# Demo-only retrieval from the legacy MIETIC case corpus.
RAG_DEMO_LEGACY_MIETIC_ENABLED=false

# ---- LLM Configuration ----
MODEL_NAME=gpt-4o-mini
# Keep DeepAgent on the same lightweight model for local/demo usage.
DEEPAGENT_MODEL_NAME=gpt-4o-mini
OPENAI_API_KEY=your-openai-api-key

# ---- Database (Khớp 100% với docker-compose.yml) ----
POSTGRES_USER=triage_user
POSTGRES_PASSWORD=triage_password
POSTGRES_DB=triage_db

# Chuỗi kết nối khi chạy script hoặc server trên terminal local (ngoài Docker):
DATABASE_URL=postgresql+asyncpg://triage_user:triage_password@localhost:5433/triage_db
SYNC_DATABASE_URL=postgresql://triage_user:triage_password@localhost:5433/triage_db
# Chú ý: khi chạy bên trong container Docker, docker-compose.yml tự động thay localhost thành postgres.

# Optional fallback provider used by src/services/llm_provider.py after OpenAI.
GROQ_API_KEY=your-groq-api-key

# ---- Vector Store ----
# KHÔNG CÒN DÙNG. Kiến trúc truy xuất thật hiện nay là pgvector nằm trong chính
# PostgreSQL ở trên (bảng simple_agent_protocol_atoms và
# simple_agent_fact_target_embeddings, mô hình text-embedding-3-small, 1536
# chiều). Không có ChromaDB và không có Pinecone trong luồng đang chạy; ba biến
# dưới đây chỉ còn là dấu vết của kiến trúc cũ và bị Settings(extra="ignore")
# bỏ qua hoàn toàn. Giữ lại ở dạng chú thích để không ai cấu hình nhầm rồi
# tưởng hệ thống đang đọc chúng.
# CHROMA_PERSIST_DIR=./data/chroma
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- Bảo mật: BẮT BUỘC đổi trước khi chạy thật ----
# Không đặt biến này thì hệ thống chạy bằng khoá mặc định ghi cứng trong
# src/config.py, tức là mọi token JWT đều giả mạo được.
# Sinh nhanh:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=doi-thanh-mot-chuoi-ngau-nhien-that-dai

# ---- Chọn luồng agent ----
# Triage Agent (src/simple_agent) là luồng đang được phát triển; để "false" thì
# toàn bộ endpoint /api/v1/simple-triage/* trả 503.
SIMPLE_AGENT_ENABLED=true
# Luồng DeepAgent cũ, chạy song song ở /api/v1/triage/*.
DEEPAGENT_RUNTIME_ENABLED=true

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
# 127.0.0.1 và localhost là HAI origin khác nhau với mọi trình duyệt. Luồng
# đăng nhập OAuth trả người dùng về đúng origin họ đang mở, nhưng chỉ khi
# origin đó nằm trong danh sách này -- xem src/services/oauth_service.py.
# Thiếu 127.0.0.1 thì ai mở app bằng địa chỉ đó sẽ đăng nhập xong mà tab cũ
# vẫn ở trạng thái chưa đăng nhập.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# ---- LangSmith observability for the active Simple Agent ----
# Selective tracing keeps the legacy DeepAgent runtime out of this project.
# Leave disabled until a real workspace-scoped key is configured.
LANGSMITH_API_KEY=your-langsmith-key
LANGSMITH_PROJECT=medtriage-simple-agent-local
LANGSMITH_TRACING=false
SIMPLE_AGENT_LANGSMITH_ENABLED=false
# Safe default: nested prompts, patient messages, snapshots and model outputs
# are hidden. Development-only opt-in; regex redaction cannot guarantee that
# free-form clinical text is de-identified.
SIMPLE_AGENT_LANGSMITH_TRACE_CONTENT=false
# Set only when the workspace is outside the default US region/self-hosted.
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=your-ai-log-api-key
AI_LOG_DIR=.ai-log

# ---- Offline triage protocol corpus builder ----
PROTOCOL_OPENAI_EXTRACTION_MODEL=gpt-4o-mini
PROTOCOL_OPENAI_VERIFICATION_MODEL=gpt-5-mini
PROTOCOL_OPENAI_PAGES_PER_REQUEST=4
PROTOCOL_OPENAI_EXTRACTION_MAX_OUTPUT_TOKENS=16000
PROTOCOL_OPENAI_VERIFICATION_MAX_OUTPUT_TOKENS=8000
PROTOCOL_OPENAI_REQUEST_TIMEOUT_SECONDS=60
PROTOCOL_OPENAI_MAX_RETRIES=2

# ---- LLM-as-Judge evaluation (report-only, uses OPENAI_API_KEY above) ----
LLM_JUDGE_PROVIDER=openai
LLM_JUDGE_MODEL=gpt-5-mini
LLM_JUDGE_TEMPERATURE=0
LLM_JUDGE_MAX_RETRIES=2
LLM_JUDGE_MAX_OUTPUT_TOKENS=2000

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000

# UNUSED by current src/config.py / src/services/llm_provider.py:
# Provider priority is currently code-defined as OpenAI -> Gemini -> Groq -> Mock.
# GOOGLE_API_KEY is still used as the Gemini fallback credential when configured,
# but the selector/model variables below are ignored because Settings(extra="ignore") drops them.
# GOOGLE_API_KEY=
# DEFAULT_LLM_PROVIDER=gemini
# FALLBACK_LLM_PROVIDER=groq
# GEMINI_MODEL=gemini-1.5-pro
# FAST_REFLEX_MODEL=gemini-1.5-flash

# --- LOCAL EMBEDDINGS FOR VECTOR DB ($0 COST) ---
EMBEDDING_MODEL_NAME=BAAI/bge-m3   # Chạy Offline 100% trong RAM máy bạn/Docker, không tốn Key!
EMBEDDING_MODEL_REVISION=5617a9f61b028005a4858fdac845db406aefb181

# ---- OAuth 2.0 (Google & GitHub) ----
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback/google

GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:3000/auth/callback/github

# ---- Email / SMTP Server Configuration (OTP & Password Reset) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-hospital-system-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=noreply-aitriage@hospital.vn
SMTP_FROM_NAME="Hệ thống AI Triage Cấp cứu"

# ---- Tìm cơ sở y tế gần người bệnh (Nearby Facilities) ----
# Tính năng hiện với các mức ESI khẩn (1/2/3): người bệnh bật định vị, hệ thống
# liệt kê cơ sở y tế gần nhất và mở deep link chỉ đường Google Maps.
#
# Khoá này CHỈ nằm ở backend. Tuyệt đối không tạo biến NEXT_PUBLIC_GOOGLE_MAPS_*
# ở frontend: mọi biến NEXT_PUBLIC_* đều bị nhúng vào bundle và ai cũng đọc được.
# Deep link chỉ đường mà giao diện dùng là URL công khai, không cần khoá.
#
# Để trống thì tính năng vẫn chạy: nó dùng danh bạ nội bộ (data/facilities/vi.json,
# nạp bằng `python scripts/seed_medical_facilities.py`).
GOOGLE_MAPS_API_KEY=

# auto  = có khoá thì gọi Google Places, hỏng thì tự rơi về danh bạ nội bộ (mặc định)
# local = chỉ dùng danh bạ nội bộ, không phát sinh chi phí
# google = ưu tiên Google, nhưng vẫn rơi về danh bạ nội bộ khi gọi hỏng
FACILITY_PROVIDER=auto

FACILITY_SEARCH_RADIUS_METERS=10000
FACILITY_MAX_RESULTS=8
FACILITY_CACHE_TTL_SECONDS=300
FACILITY_PROVIDER_TIMEOUT_SECONDS=5
# Hạn mức gọi Google theo từng tài khoản. Vượt hạn mức KHÔNG chặn người bệnh --
# lần tra cứu đó chỉ chuyển sang dùng danh bạ nội bộ.
FACILITY_LOOKUPS_PER_USER=20
FACILITY_RATE_LIMIT_WINDOW_SECONDS=300
